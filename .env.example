# Copy this file to .env and fill values locally.
# Never commit the real .env file.

TELEGRAM_BOT_TOKEN=123456789:replace-with-your-telegram-bot-token
TELEGRAM_CHAT_ID=123456789
TELEGRAM_BOT_USERNAME=your_bot_username

# TCDD API bearer token. Keep private and rotate when needed.
TCDD_BEARER_TOKEN=replace-with-current-tcdd-bearer-token

