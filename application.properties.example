# TCDD Bot Konfigürasyon Dosyası
# Bu dosyayı JAR dosyasının bulunduğu dizine "application.properties" adıyla kaydedin

# Sunucu Ayarları
server.port=9090
spring.application.name=YHT Ticket Alarm
vaadin.frontend.hotdeploy=false

# Telegram Bot Ayarları
# Bot token'ınızı BotFather'dan alın: https://t.me/BotFather
telegram.bot.token=${TELEGRAM_BOT_TOKEN}

# Chat ID'nizi @userinfobot'tan öğrenin: https://t.me/userinfobot
telegram.chat.id=${TELEGRAM_CHAT_ID}
telegram.bot.username=${TELEGRAM_BOT_USERNAME:TCDDBiletBot}

# TCDD API Token
# Gerçek değeri .env veya ortam değişkeni üzerinden verin; repoya yazmayın.
app.bearer-token=${TCDD_BEARER_TOKEN}

# İsteğe Bağlı Gelişmiş Ayarlar

# Log Seviyesi (ERROR, WARN, INFO, DEBUG)
logging.level.services=INFO
logging.level.root=WARN

# Log dosyasına kaydetme (isteğe bağlı)
# logging.file.name=tcdd-bot.log

# JVM Bellek Ayarları (komut satırından)
# java -Xmx512m -Xms256m -jar TrainTicketTracker-1.0-SNAPSHOT.jar
